//ALLOCATE JOB (ACCT01),'BENEFIT DATASETS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//* Replace ACCT01/CLASS/MSGCLASS with values required at your site.
//ALLOC    EXEC PGM=IEFBR14
//COBSRC   DD  DSN=&SYSUID..BENEFIT.COBOL,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(5,2,10)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=0)
//COPYLIB  DD  DSN=&SYSUID..BENEFIT.COPY,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(2,1,10)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=0)
//JCLLIB   DD  DSN=&SYSUID..BENEFIT.JCL,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(2,1,10)),
//             DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=0)
//RAWIN    DD  DSN=&SYSUID..BENEFIT.RAW.INPUT,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(2,1),RLSE),
//             DCB=(DSORG=PS,RECFM=FB,LRECL=50,BLKSIZE=0)
//LOADLIB  DD  DSN=&SYSUID..LOADLIB,
//             DISP=(NEW,CATLG,DELETE),
//             UNIT=SYSDA,SPACE=(TRK,(10,5,10)),
//             DSNTYPE=LIBRARY,
//             DCB=(DSORG=PO,RECFM=U,LRECL=0,BLKSIZE=32760)
