//RUNBEN   JOB (ACCT01),'BENEFIT BATCH',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*
//* STEP 1: SORT BY CITIZEN ID (COLS 1-6) & FILTER ACTIVE ('A') ONLY
//*
//STEP01   EXEC PGM=SORT
//SYSOUT   DD SYSOUT=*
//SORTIN   DD DSN=&SYSUID..BENEFIT.RAW.INPUT,DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS),
//            UNIT=SYSDA,SPACE=(TRK,(2,2),RLSE),
//            DCB=(RECFM=FB,LRECL=50,BLKSIZE=0)
//SYSIN    DD *
  SORT FIELDS=(1,6,CH,A)
  INCLUDE COND=(20,1,CH,EQ,C'A')
/*
//*
//* STEP 2: EXECUTE COMPILED COBOL BENEFIT PROGRAM
//*
//STEP02   EXEC PGM=BENEFIT,COND=(0,NE,STEP01)
//STEPLIB  DD DSN=&SYSUID..LOADLIB,DISP=SHR
//INDD     DD DSN=&&SORTED,DISP=(OLD,DELETE)
//OUTDD    DD DSN=&SYSUID..BENEFIT.RPT2601.OUT,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=0)
//SYSOUT   DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
